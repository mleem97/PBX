# FreePBX Docker - Beispiel-Umgebung
# Kopieren nach .env bzw. .env.prod und anpassen:
#   cp .env.example .env.prod
#
# Image
IMAGE_REGISTRY=mleem97
IMAGE_TAG=17

# Compose-Dateien
COMPOSE_FILE=docker-compose.prod.yml
ENV_FILE=.env

# Ports
HTTP_PORT=8080
HTTPS_PORT=8443
SIP_PORT=5060
SIPS_PORT=5061
RTP_START=10000
RTP_END=20000

# Zeitzone
TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Datenbank (leer lassen = kein Passwort setzen)
MYSQL_ROOT_PASSWORD=

# SSL Zertifikate (Verzeichnis mit certs, wird nach /etc/ssl/certs/freepbx gemountet)
SSL_CERT_PATH=./ssl
